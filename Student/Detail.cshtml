@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="details-card">
    <h1>Student Details</h1>

    <dl class="details-list">
        <dt>Student ID</dt>
        <dd>@Model.Id</dd>

        <dt>Student Name</dt>
        <dd>@Model.Name</dd>

        <dt>Email Address</dt>
        <dd>@Model.Email</dd>

        <dt>Course</dt>
        <dd>@Model.Course</dd>

        <dt>Semester</dt>
        <dd>@Model.Semester</dd>
    </dl>

    <div class="actions">
        <a class="btn secondary" asp-action="Index">
            Back to Student List
        </a>

        <a class="btn primary"
           asp-controller="Home"
           asp-action="Index">
            Home
        </a>
    </div>
</div>
