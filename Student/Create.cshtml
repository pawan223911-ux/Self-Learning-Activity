@model StudentCourseRegistration.Models.Student

@{
    ViewData["Title"] = "Student Registration";
}

<div class="form-card">
    <h1>Student Registration Form</h1>
    <p class="muted">Enter the student information below.</p>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name"
                   placeholder="Enter student name" />
            <span asp-validation-for="Name"
                  class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email"
                   type="email"
                   placeholder="Enter email address" />
            <span asp-validation-for="Email"
                  class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Course"></label>
            <input asp-for="Course"
                   placeholder="Enter course name" />
            <span asp-validation-for="Course"
                  class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Semester"></label>

            <select asp-for="Semester">
                <option value="">Select Semester</option>

                @for (int i = 1; i <= 8; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>

            <span asp-validation-for="Semester"
                  class="field-error"></span>
        </div>

        <div class="actions">
            <button type="submit" class="btn primary">
                Submit Registration
            </button>

            <a asp-action="Index" class="btn secondary">
                Cancel
            </a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
